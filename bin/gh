#!/usr/bin/env bash
#
# gh, as the team's GitHub App. dispatch.sh puts this directory first on a run's PATH and names the
# team in A_TEAM_RUN_TEAM; anywhere else it's the real gh, unchanged.
#
set -euo pipefail

here="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
path=
IFS=: read -ra dirs <<<"$PATH"
# Skip every a-team bin/, not just this one, or two copies on PATH call each other for ever.
for dir in "${dirs[@]}"; do
  [ -f "${dir:-.}/../scripts/github-app.sh" ] || path=${path:+$path:}$dir
done
real=$(PATH=$path command -v gh) || { echo "gh: not installed" >&2; exit 127; }

if [ -n "${A_TEAM_RUN_TEAM:-}" ]; then
  token=$("$here/a-team" token "$A_TEAM_RUN_TEAM")
  GH_TOKEN=$token exec "$real" "$@"
fi
exec "$real" "$@"
